{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pbd:schema:v1:gate-report",
  "title": "PBD quality gate report v1",
  "description": "G01-G13 unchanged plus stable extensions G14-G18. PASS requires evidence matching the gate kind; the runtime additionally enforces kind-specific rules (see pbd.validation.gates).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "gates"],
  "properties": {
    "schema_version": {"$ref": "urn:pbd:schema:v1:defs#/$defs/schemaVersion"},
    "kind": {"const": "pbd.gate-report"},
    "run_id": {"type": "string", "pattern": "^PBD-RUN-[0-9A-HJKMNP-TV-Z]{12}$"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "scope", "validator_version", "reason", "evidence"],
        "properties": {
          "id": {"$ref": "urn:pbd:schema:v1:defs#/$defs/gateId"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"]},
          "scope": {"type": "string"},
          "validator_version": {"type": "string"},
          "reason": {"$ref": "urn:pbd:schema:v1:defs#/$defs/nonEmpty"},
          "evidence": {"type": "array", "items": {"$ref": "urn:pbd:schema:v1:defs#/$defs/evidence"}},
          "verification": {
            "description": "declared: evidence records exist; verified: every cited artifact was re-hashed and bound to this run/stage by the runtime; failed: verification found a mismatch.",
            "enum": ["declared", "verified", "failed"]
          },
          "denominator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["examined", "total", "provenance"],
            "properties": {
              "examined": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 0},
              "provenance": {"enum": ["independent_inventory", "benchmark_gold", "generated_set", "schema_count"]},
              "inventory_ref": {"type": "string"},
              "inventory_digest": {"$ref": "urn:pbd:schema:v1:defs#/$defs/digest"},
              "reading_complete": {"type": "boolean"},
              "breakdown": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "covered": {"type": "integer", "minimum": 0},
                  "partially_covered": {"type": "integer", "minimum": 0},
                  "not_covered": {"type": "integer", "minimum": 0},
                  "question_required": {"type": "integer", "minimum": 0},
                  "conflicting": {"type": "integer", "minimum": 0},
                  "blocked": {"type": "integer", "minimum": 0},
                  "out_of_scope": {"type": "integer", "minimum": 0},
                  "superseded": {"type": "integer", "minimum": 0},
                  "deferred": {"type": "integer", "minimum": 0},
                  "unassessed": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"evidence": {"minItems": 1}}}}
        ]
      }
    }
  }
}
