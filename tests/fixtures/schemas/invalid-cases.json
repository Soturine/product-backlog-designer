{
  "description": "Each case applies operations to a valid synthetic fixture and must be rejected with the expected issue code. Paths are lists of keys/indexes.",
  "cases": [
    {"id": "item-missing-title", "base": "backlog", "ops": [{"op": "del", "path": ["items", 2, "title"]}], "expect": "schema"},
    {"id": "covered-without-covered-by", "base": "backlog", "ops": [{"op": "del", "path": ["claims", 0, "disposition", "covered_by"]}], "expect": "schema"},
    {"id": "assessed-without-rationale", "base": "backlog", "ops": [{"op": "del", "path": ["claims", 3, "disposition", "rationale"]}], "expect": "schema"},
    {"id": "unset-field-with-value", "base": "backlog", "ops": [{"op": "set", "path": ["items", 2, "fields", "priority", "value"], "value": 0}], "expect": "schema"},
    {"id": "confirmed-field-without-evidence", "base": "backlog", "ops": [{"op": "set", "path": ["items", 2, "fields", "story_points", "state"], "value": "confirmed"}], "expect": "schema"},
    {"id": "proposed-field-without-rationale", "base": "backlog", "ops": [{"op": "del", "path": ["items", 2, "fields", "story_points", "rationale"]}], "expect": "schema"},
    {"id": "unsourced-item-without-rationale", "base": "backlog", "ops": [{"op": "del", "path": ["items", 3, "technical_rationale"]}], "expect": "schema"},
    {"id": "locator-without-position", "base": "backlog", "ops": [{"op": "set", "path": ["claims", 0, "evidence", 0, "locator"], "value": {"source_id": "PBD-SRC-000000000001", "source_version": "v1"}}], "expect": "schema"},
    {"id": "claim-without-evidence", "base": "backlog", "ops": [{"op": "set", "path": ["claims", 0, "evidence"], "value": []}], "expect": "schema"},
    {"id": "pbd-id-in-tracker-namespace", "base": "backlog", "ops": [{"op": "set", "path": ["items", 4, "external_refs", 0, "native_id"], "value": "PBD-TASK-000000000001"}], "expect": "schema"},
    {"id": "title-derived-id", "base": "backlog", "ops": [{"op": "set", "path": ["items", 2, "id"], "value": "PBD-STORY-reservar-canteiro"}], "expect": "schema"},
    {"id": "confirmed-criterion-without-claim", "base": "backlog", "ops": [{"op": "set", "path": ["criteria", 0, "claim_refs"], "value": []}], "expect": "schema"},
    {"id": "criterion-without-outcome", "base": "backlog", "ops": [{"op": "set", "path": ["criteria", 0, "expected_outcomes"], "value": []}], "expect": "schema"},
    {"id": "proposed-criterion-without-rationale", "base": "backlog", "ops": [{"op": "del", "path": ["criteria", 2, "rationale"]}], "expect": "schema"},
    {"id": "unknown-property", "base": "backlog", "ops": [{"op": "set", "path": ["items", 0, "assignee"], "value": "someone"}], "expect": "schema"},
    {"id": "superseded-without-edge", "base": "backlog", "ops": [{"op": "del", "path": ["claims", 2, "temporal", "superseded_by"]}], "expect": "schema"},
    {"id": "answered-question-without-decision", "base": "backlog", "ops": [{"op": "set", "path": ["questions", 0, "status"], "value": "answered"}], "expect": "schema"},
    {"id": "duplicate-identifier", "base": "backlog", "ops": [{"op": "set", "path": ["items", 4, "id"], "value": "PBD-STORY-000000000001"}], "expect": "duplicate_id"},
    {"id": "dangling-parent", "base": "backlog", "ops": [{"op": "set", "path": ["items", 4, "parent"], "value": "PBD-STORY-0000000000ZZ"}], "expect": "dangling_ref"},
    {"id": "dangling-claim-ref", "base": "backlog", "ops": [{"op": "append", "path": ["items", 2, "claim_refs"], "value": "PBD-CLM-0000000000ZZ"}], "expect": "dangling_ref"},
    {"id": "orphan-task", "base": "backlog", "ops": [{"op": "set", "path": ["items", 4, "parent"], "value": null}], "expect": "orphan"},
    {"id": "story-under-task", "base": "backlog", "ops": [{"op": "set", "path": ["items", 2, "parent"], "value": "PBD-TASK-000000000001"}], "expect": "invalid_parent"},
    {"id": "hierarchy-cycle", "base": "backlog", "ops": [{"op": "set", "path": ["items", 1, "parent"], "value": "PBD-STORY-000000000001"}], "expect": "cycle"},
    {"id": "dependency-cycle", "base": "backlog", "ops": [{"op": "append", "path": ["relations"], "value": {"id": "PBD-REL-000000000002", "type": "predecessor", "source": "PBD-STORY-000000000001", "target": "PBD-ENAB-000000000001", "status": "proposed", "reason": "mutation"}}], "expect": "cycle"},
    {"id": "relation-self-loop", "base": "backlog", "ops": [{"op": "set", "path": ["relations", 0, "target"], "value": "PBD-ENAB-000000000001"}], "expect": "self_loop"},
    {"id": "stale-locator-version", "base": "backlog", "ops": [{"op": "set", "path": ["claims", 0, "evidence", 0, "locator", "source_version"], "value": "v0"}], "expect": "stale_locator"},
    {"id": "asymmetric-supersession", "base": "backlog", "ops": [{"op": "set", "path": ["claims", 0, "temporal", "supersedes"], "value": ["PBD-CLM-000000000002"]}], "expect": "asymmetric_supersession"},
    {"id": "duplicate-tracker-binding", "base": "backlog", "ops": [{"op": "set", "path": ["items", 2, "external_refs"], "value": [{"system": "mock", "namespace": "fixture-project", "native_id": "1001"}]}], "expect": "duplicate_binding"},
    {"id": "criterion-under-task", "base": "backlog", "ops": [{"op": "set", "path": ["criteria", 0, "parent"], "value": "PBD-TASK-000000000001"}], "expect": "invalid_parent"},
    {"id": "offline-with-remote-calls", "base": "run-manifest", "ops": [{"op": "set", "path": ["network", "remote_calls"], "value": 3}], "expect": "schema"},
    {"id": "complete-stage-without-digests", "base": "run-manifest", "ops": [{"op": "del", "path": ["stages", 0, "output_digest"]}], "expect": "schema"},
    {"id": "invalidated-stage-without-reason", "base": "run-manifest", "ops": [{"op": "del", "path": ["stages", 1, "invalidated_reason"]}], "expect": "schema"},
    {"id": "absolute-artifact-path", "base": "run-manifest", "ops": [{"op": "set", "path": ["artifacts", 0, "path"], "value": "C:/private/backlog.json"}], "expect": "schema"},
    {"id": "gate-pass-without-evidence", "base": "gate-report", "ops": [{"op": "set", "path": ["gates", 0, "evidence"], "value": []}], "expect": "schema"},
    {"id": "unknown-gate-id", "base": "gate-report", "ops": [{"op": "set", "path": ["gates", 1, "id"], "value": "G19"}], "expect": "schema"},
    {"id": "deterministic-gate-review-only", "base": "gate-report", "ops": [{"op": "set", "path": ["gates", 0, "evidence"], "value": [{"type": "review", "ref": "reviewer-notes"}]}], "expect": "gate_evidence"},
    {"id": "semantic-gate-without-review", "base": "gate-report", "ops": [{"op": "set", "path": ["gates", 2], "value": {"id": "G13", "status": "PASS", "scope": "review", "validator_version": "x", "reason": "claimed", "evidence": [{"type": "deterministic_check", "ref": "schema"}], "denominator": {"examined": 4, "total": 4, "provenance": "independent_inventory"}}}], "expect": "gate_evidence"},
    {"id": "coverage-from-generated-set", "base": "gate-report", "ops": [{"op": "set", "path": ["gates", 1], "value": {"id": "G02", "status": "PASS", "scope": "coverage", "validator_version": "x", "reason": "claimed", "evidence": [{"type": "deterministic_check", "ref": "count"}, {"type": "review", "ref": "r1"}], "denominator": {"examined": 4, "total": 4, "provenance": "generated_set"}}}], "expect": "gate_denominator"},
    {"id": "coverage-empty-denominator", "base": "gate-report", "ops": [{"op": "set", "path": ["gates", 1], "value": {"id": "G02", "status": "PASS", "scope": "coverage", "validator_version": "x", "reason": "claimed", "evidence": [{"type": "deterministic_check", "ref": "count"}, {"type": "review", "ref": "r1"}], "denominator": {"examined": 0, "total": 0, "provenance": "independent_inventory"}}}], "expect": "gate_denominator"},
    {"id": "coverage-incomplete-examination", "base": "gate-report", "ops": [{"op": "set", "path": ["gates", 1], "value": {"id": "G01", "status": "PASS", "scope": "sources", "validator_version": "x", "reason": "claimed", "evidence": [{"type": "deterministic_check", "ref": "count"}, {"type": "review", "ref": "r1"}], "denominator": {"examined": 3, "total": 5, "provenance": "independent_inventory"}}}], "expect": "gate_denominator"},
    {"id": "duplicate-gate", "base": "gate-report", "ops": [{"op": "append", "path": ["gates"], "value": {"id": "G03", "status": "NOT_RUN", "scope": "x", "validator_version": "x", "reason": "dup", "evidence": []}}], "expect": "gate"},
    {"id": "delete-operation", "base": "publication-plan", "ops": [{"op": "set", "path": ["operations", 0, "action"], "value": "DELETE"}], "expect": "schema"},
    {"id": "update-without-revision", "base": "publication-plan", "ops": [{"op": "del", "path": ["operations", 1, "expected_revision"]}], "expect": "schema"},
    {"id": "create-with-tracker-id", "base": "publication-plan", "ops": [{"op": "set", "path": ["operations", 0, "external_ref"], "value": {"system": "mock", "namespace": "fixture-project", "native_id": "9"}}], "expect": "schema"},
    {"id": "deferred-without-reason", "base": "publication-plan", "ops": [{"op": "del", "path": ["operations", 2, "reason"]}], "expect": "schema"},
    {"id": "approved-without-binding", "base": "publication-plan", "ops": [{"op": "set", "path": ["approval"], "value": {"state": "approved"}}], "expect": "schema"},
    {"id": "mock-claims-live-verification", "base": "publication-receipt", "ops": [{"op": "set", "path": ["verification", "status"], "value": "LIVE_VERIFIED"}], "expect": "schema"},
    {"id": "live-claims-mock-verification", "base": "publication-receipt", "ops": [{"op": "set", "path": ["transport"], "value": "live"}], "expect": "schema"}
  ]
}
